# ======= recategorizacion-jornales — variables de entorno =======
# Copiar a .env y completar con valores reales (el admin de Sistemas lo hace en el servidor).

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Base de datos (SQLite) ---
# Ruta ABSOLUTA dentro del contenedor (bind mount ./data:/app/data)
DB_PATH=/app/data/recategorizacion-jornales.db

# --- Sesión / Auth ---
# Secreto para firmar las cookies de sesión (JWT HS256). Generar uno largo y aleatorio:
#   openssl rand -base64 48
SESSION_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio
# Auth.js compat (la app usa sesión propia por cookie, se mantiene por estándar SicaLab)
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://recategorizacion-jornales.sica

# --- Usuario administrador inicial (se siembra en el primer arranque si no existe) ---
# Cambiar por el mail real del administrador inicial (se completa en el .env del servidor).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_NOMBRE=Administrador
# Contraseña inicial del admin. CAMBIAR al entrar por primera vez (zona Usuarios).
ADMIN_INITIAL_PASSWORD=CAMBIAR_por_una_contraseña_segura
